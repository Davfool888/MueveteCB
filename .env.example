# Configuración del agente Eco. Copia estas claves a .env.local; nunca subas el archivo real.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# En Vercel dev local, usa true para probar /api/chat desde el navegador.
VITE_CHAT_API=false

# Configuración pública del SDK web de Firebase Authentication.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
