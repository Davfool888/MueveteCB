# Configuración del agente Eco con Gemini. Copia estas claves a .env.local; nunca subas el archivo real.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# En Vercel dev local, usa true para probar /api/chat desde el navegador.
VITE_CHAT_API=false

# Router vial. OSRM público es solo para demostración; en producción usa un servicio con SLA.
VITE_ROUTING_API_URL=https://router.project-osrm.org
VITE_ROUTING_TIMEOUT_MS=9000

# Geocodificador OSM opcional. Si se deja vacío se usa Nominatim público.
VITE_GEOCODING_URL=
# Radios configurables del contexto de transporte, en kilómetros.
VITE_SITP_COVERAGE_RADIUS_KM=0.6
VITE_VEREDAL_SEARCH_RADIUS_KM=4.5

# Configuración pública del SDK web de Firebase Authentication.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
