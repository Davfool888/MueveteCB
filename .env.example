ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# En Vercel dev local o vite dev, usa true para probar /api/chat desde el navegador.
VITE_CHAT_API=true

# Proveedor alternativo / respaldo: Google Gemini (obtenida gratis en https://aistudio.google.com/app/apikey)
